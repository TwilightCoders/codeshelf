src/**
.vscode/**
tsconfig*.json
**/*.map
.gitignore
.Codex/**
.claude/**
test/**
scripts/**
out-webview/dev/**
dev.html
eslint.config.mjs
.prettierrc.json
vitest*.config.ts
esbuild.mjs

# Drop all of node_modules EXCEPT runtime assets/deps the host actually loads:
# the codicons font/css (webview <link>) and `ignore` (host requires it at runtime;
# webview deps like react are bundled by esbuild so they don't need to ship).
node_modules/**
!node_modules/ignore/**

# Design/provenance docs and the dev workspace file aren't part of the product.
docs/**
CONTRIBUTING.md
*.code-workspace
media/icon.svg
# README screenshots are resolved from the repository by the Marketplace,
# so they don't need to ship inside the package.
media/screenshots/**

# Codicons ships previews, build scripts and per-icon SVGs; the webview only
# <link>s the stylesheet and its font.
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf
