{
  "name": "codeshelf",
  "displayName": "CodeShelf",
  "description": "A Steam Library-style project browser for VS Code",
  "version": "0.1.0",
  "publisher": "twilightcoders",
  "author": "Dale Stevens",
  "license": "MIT",
  "icon": "media/icon.png",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "project",
    "browser",
    "launcher",
    "workspace",
    "dashboard",
    "start page",
    "projects",
    "git",
    "monorepo",
    "library"
  ],
  "galleryBanner": {
    "color": "#15171c",
    "theme": "dark"
  },
  "preview": true,
  "qna": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwilightCoders/codeshelf.git"
  },
  "bugs": {
    "url": "https://github.com/TwilightCoders/codeshelf/issues"
  },
  "homepage": "https://github.com/TwilightCoders/codeshelf#readme",
  "engines": {
    "vscode": "^1.108.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeshelf.open",
        "title": "Open",
        "category": "CodeShelf"
      },
      {
        "command": "codeshelf.editSettings",
        "title": "Edit Settings (JSON)",
        "category": "CodeShelf"
      },
      {
        "command": "codeshelf.clearCache",
        "title": "Clear Cache",
        "category": "CodeShelf"
      },
      {
        "command": "codeshelf.editCache",
        "title": "Edit Cache",
        "category": "CodeShelf"
      }
    ],
    "configuration": {
      "title": "CodeShelf",
      "properties": {
        "codeshelf.roots": {
          "type": "object",
          "default": {},
          "markdownDescription": "Root directories to scan, keyed by absolute path. Each root can have a label, visibility, and per-shelf metadata.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Display label for this root"
              },
              "defaultVisibility": {
                "type": "string",
                "enum": [
                  "show-all",
                  "hide-all"
                ],
                "default": "show-all",
                "description": "Whether to show or hide shelves by default"
              },
              "filter": {
                "type": "object",
                "properties": {
                  "order": {
                    "type": "string",
                    "description": "Sort order for projects (e.g. 'modified asc', 'name desc')"
                  }
                }
              },
              "shelves": {
                "type": "object",
                "description": "Per-shelf overrides, keyed by absolute path or directory name",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Display name override"
                    },
                    "description": {
                      "type": "string"
                    },
                    "hidden": {
                      "type": "boolean",
                      "description": "Hide this shelf"
                    },
                    "starred": {
                      "type": "boolean",
                      "description": "Star/favorite this shelf"
                    },
                    "flatten": {
                      "type": "string",
                      "enum": [
                        "auto",
                        "always",
                        "never"
                      ],
                      "default": "auto",
                      "description": "Control bookset flattening: auto (use threshold), always (force flat), never (keep booksets)"
                    },
                    "projects": {
                      "type": "object",
                      "description": "Per-project overrides, keyed by path or directory name",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "poster": {
                            "type": "string"
                          },
                          "tags": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "hidden": {
                            "type": "boolean",
                            "description": "Hide this project"
                          },
                          "starred": {
                            "type": "boolean",
                            "description": "Star/favorite this project"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "codeshelf.booksetThreshold": {
          "type": "number",
          "default": 8,
          "description": "Booksets with this many or fewer total projects are flattened into the shelf grid"
        },
        "codeshelf.scanDepth": {
          "type": "number",
          "default": 3,
          "description": "Maximum directory depth to scan for projects"
        },
        "codeshelf.openInNewWindow": {
          "type": "boolean",
          "default": false,
          "description": "Open projects in a new window instead of the current one"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.mjs",
    "compile:check": "tsc -p ./ && tsc -p ./tsconfig.webview.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check \"src/**/*.{ts,tsx}\"",
    "watch": "tsc -watch -p ./",
    "watch:webview": "node esbuild.mjs --watch",
    "dev": "node esbuild.mjs && open dev.html",
    "dev:watch": "node esbuild.mjs --watch",
    "screenshot": "node esbuild.mjs && node scripts/screenshot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:all": "vitest run && vitest run --config vitest.browser.config.ts",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.108.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.6.0",
    "jest-mock-vscode": "^4.12.0",
    "prettier": "^3.8.3",
    "puppeteer-core": "^24.40.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.2",
    "wordnet-db": "^3.1.14"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "canvas-confetti": "^1.9.4",
    "ignore": "^7.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
