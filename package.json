{
  "name": "codeshelf",
  "displayName": "CodeShelf",
  "description": "A Steam Library-style project browser for VS Code",
  "version": "0.1.0",
  "publisher": "twilightcoders",
  "license": "MIT",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeshelf.open",
        "title": "Open CodeShelf",
        "category": "CodeShelf"
      },
      {
        "command": "codeshelf.editSettings",
        "title": "Edit Settings (JSON)",
        "category": "CodeShelf"
      }
    ],
    "configuration": {
      "title": "CodeShelf",
      "properties": {
        "codeshelf.roots": {
          "type": "object",
          "default": {},
          "markdownDescription": "Root directories to scan, keyed by absolute path. Each root can have a label, visibility, and per-shelf metadata.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Display label for this root"
              },
              "defaultVisibility": {
                "type": "string",
                "enum": [
                  "show-all",
                  "hide-all"
                ],
                "default": "show-all",
                "description": "Whether to show or hide shelves by default"
              },
              "filter": {
                "type": "object",
                "properties": {
                  "order": {
                    "type": "string",
                    "description": "Sort order for projects (e.g. 'modified asc', 'name desc')"
                  }
                }
              },
              "shelves": {
                "type": "object",
                "description": "Per-shelf overrides, keyed by absolute path or directory name",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Display name override"
                    },
                    "description": {
                      "type": "string"
                    },
                    "hidden": {
                      "type": "boolean",
                      "description": "Hide this shelf"
                    },
                    "starred": {
                      "type": "boolean",
                      "description": "Star/favorite this shelf"
                    },
                    "flatten": {
                      "type": "string",
                      "enum": [
                        "auto",
                        "always",
                        "never"
                      ],
                      "default": "auto",
                      "description": "Control bookset flattening: auto (use threshold), always (force flat), never (keep booksets)"
                    },
                    "projects": {
                      "type": "object",
                      "description": "Per-project overrides, keyed by path or directory name",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "poster": {
                            "type": "string"
                          },
                          "tags": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "hidden": {
                            "type": "boolean",
                            "description": "Hide this project"
                          },
                          "starred": {
                            "type": "boolean",
                            "description": "Star/favorite this project"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "codeshelf.booksetThreshold": {
          "type": "number",
          "default": 8,
          "description": "Booksets with this many or fewer total projects are flattened into the shelf grid"
        },
        "codeshelf.scanDepth": {
          "type": "number",
          "default": 3,
          "description": "Maximum directory depth to scan for projects"
        },
        "codeshelf.openInNewWindow": {
          "type": "boolean",
          "default": false,
          "description": "Open projects in a new window instead of the current one"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.mjs",
    "compile:check": "tsc -p ./ && tsc -p ./tsconfig.webview.json --noEmit",
    "watch": "tsc -watch -p ./",
    "watch:webview": "node esbuild.mjs --watch",
    "dev": "node esbuild.mjs && open dev.html",
    "dev:watch": "node esbuild.mjs --watch",
    "screenshot": "node esbuild.mjs && node scripts/screenshot.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.108.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "esbuild": "^0.27.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
